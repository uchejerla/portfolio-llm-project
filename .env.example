# Optional — without a key the studio runs in local draft mode.
# Claude (recommended)
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-4-5
ANTHROPIC_MODEL=

# Or any OpenAI-compatible chat completions endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional — PostHog session replay. Without both values replay stays off.
# Public project token from PostHog → Project settings. Never a personal API key.
VITE_POSTHOG_PROJECT_TOKEN=
# Your project's region host, chosen by you: https://us.i.posthog.com or https://eu.i.posthog.com
VITE_POSTHOG_HOST=

# API server port (Vite proxies /api here)
PORT=8787

# Optional — Google sign-in. Without both values accounts stay off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Stripe subscriptions. Billing only turns on when all three are set.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# 7-day, no-card trial. Set 0 to require a plan immediately.
TRIAL_DAYS=7
PRICE_LABEL="$9 / month"

# Local SQLite file. Defaults to .data/studio.db.
# STUDIO_DB_PATH=.data/studio.db
