{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-studio",
  "main": "sites-build/worker.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-studio",
      "database_id": "220b5e41-c206-4d54-af70-18be680b1b3f"
    }
  ]
}
